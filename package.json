{
  "name": "zmk-yakme",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Client-side ZMK keymap editor: import a physical layout and keymap, edit layers and combos, export a .keymap file.",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:all": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm test",
    "serve": "python3 -m http.server 8080"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.64.1",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "prettier": "3.9.10"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ulkden/zmk-yakme.git"
  },
  "engines": {
    "node": ">=22"
  }
}
